# Local development leaves both blank: the Vite proxy (vite.config.ts) forwards
# /v1, /ws and /health to localhost:8000, so same-origin requests just work.
#
# For a deployed build, point these at the API host. VITE_* values are inlined
# into the bundle at build time and are therefore public — VITE_API_KEY is a
# read-only demo credential, never a real secret.

# VITE_API_URL=https://quantedge-api.onrender.com
# VITE_API_KEY=quantedge-demo-key
